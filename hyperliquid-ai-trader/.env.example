# Secrets remain in the repository-root .env and must never be committed.
# HL_test_wallet is the funded parent/main Testnet account address.
# HL_test_wallet_private_key is an authorized Agent Wallet key for that account.
# Do not put the Agent Wallet address in HL_test_wallet.
HL_test_wallet=0x...
HL_test_wallet_private_key=0x...
GEMINI_API_KEY=...

HL_NETWORK=testnet
TRADING_COIN=BTC
MARGIN_MODE=isolated
LEVERAGE=5
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_NOTIONAL_USD=250
MAX_DAILY_LOSS_PCT=20
MAX_DRAWDOWN_PCT=25
MIN_STOP_LOSS_PCT=0.10
MAX_STOP_LOSS_PCT=1.00
MIN_TAKE_PROFIT_PCT=0.10
MAX_TAKE_PROFIT_PCT=2.00
MAX_HOLD_SECONDS=300
TRADER_INTERVAL_SECONDS=300
REVIEW_INTERVAL_SECONDS=7200
MANDATORY_ENTRY=false
GEMINI_MODEL=gemini-3.6-flash
# Optional safety check; the actual mode is always read from Hyperliquid.
# HL_EXPECTED_ACCOUNT_MODE=unifiedAccount
TRADER_MODEL=gemini-3.5-flash-lite
TRADER_FALLBACK_MODEL=
REVIEWER_MODEL=gemini-3.6-flash
REVIEWER_FALLBACK_MODEL=
TRADER_TEMPERATURE=0.7
REVIEWER_TEMPERATURE=0.4
EXECUTION_MODE=dry_run
TAKER_FEE_PCT=0.045
MAX_ENTRY_SLIPPAGE_BPS=50
DATABASE_PATH=data/trader.db
STRATEGY_PATH=state/strategy.json

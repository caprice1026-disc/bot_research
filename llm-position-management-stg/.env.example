BOT_ID=btc-shadow-v1
GOOGLE_CLOUD_PROJECT=replace-with-project-id
TRADER_MODEL=gemini-3.5-flash
REVIEWER_MODEL=gemini-3.8-flash
INITIAL_EQUITY=500
MAX_EXPOSURE=3
STOP_RISK=0.03
DRAWDOWN_LIMIT=0.10
EVALUATION_DD=0.15
REBALANCE_THRESHOLD=0.05
PRICE_DRIFT_LIMIT=0.003
TRADER_TIMEOUT_SECONDS=60
REVIEWER_TIMEOUT_SECONDS=180
CYCLE_TIMEOUT_SECONDS=270
MAX_START_DELAY_SECONDS=60
STRATEGY_TTL_SECONDS=21600
REVIEW_INTERVAL_SECONDS=7200
COOLDOWN_SECONDS=86400
LLM_MONTHLY_BUDGET_USD=20
LLM_BUDGET_ACTION=notify_only
# Set free only after confirming the project's actual billing tier.
BILLING_TIER=paid
TRADER_INPUT_USD_PER_MILLION=1.5
TRADER_OUTPUT_USD_PER_MILLION=9
# Conservative standard rates; adjust to the active plan, never infer free quota.
REVIEWER_INPUT_USD_PER_MILLION=1.5
REVIEWER_OUTPUT_USD_PER_MILLION=7.5
TRADER_MAX_OUTPUT_TOKENS=2048
REVIEWER_MAX_OUTPUT_TOKENS=4096
TRADER_THINKING_LEVEL=low
REVIEWER_THINKING_LEVEL=low
FEE_RATE=0.00045
SLIPPAGE_BPS=2
MIN_NOTIONAL=10
NEWS_URL=https://www.panewslab.com/rss.xml?lang=en&type=NORMAL%2CNEWS
NEWS_MAX_ITEMS=30
NEWS_MAX_AGE_SECONDS=86400
# Supply secrets through Secret Manager/environment; never commit values.
